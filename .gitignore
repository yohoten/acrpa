# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
# dist/ 下有两类文件，处置不同：
#   · dist/*.exe  —— 每次构建都变的产物，不入库
#   · dist/ACRPA.zip —— 发布包，是更新机制里"仓库内镜像直链"的兜底通道，必须纳管
#     （无版本信息，客户端靠 VERSION 里的 sha256 / 包内 VERSION 兜住旧包风险）
# 发布包由 tools/make_release.py 生成，务必与 VERSION 同一次提交、同版本。
dist/*.exe
dist/*.spec
dist/*.pkg
*.egg-info/
*.egg
.eggs/
lib/python*/

# Virtual Environment
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# ACRPA 运行时文件
logs/
screenshots/
# img/
*.log
config.json

# ACRPA 构建资源（构建输入，必须纳入版本控制）
# res/ 内含 automation.ico / wechat_qrcode.png，被 ACRPA.spec 引用，请勿加入忽略规则

# Test coverage reports
htmlcov/
.coverage
coverage.xml
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# PyInstaller
# 生成的 spec 默认忽略；ACRPA.spec 目前作为例外纳管
# 注意：ACRPA.spec 由 build.py 生成（build.py:186-187 先删除、202-232 再重建），
#      每次构建都会被重写，因此纳管它会在 git status 中产生变更噪声。
*.spec
!ACRPA.spec

# UPX (如果使用)
upx.exe
