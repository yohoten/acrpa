# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
# dist/ 下有三类文件，处置不同：
#   · dist/*.exe    —— 每次构建都变的产物，不入库
#   · dist/*.sha256 —— make_release.py 生成的本地校验和旁挂文件，不入库
#   · dist/ACRPA.zip —— 发布包，是更新机制里"仓库内镜像直链"的兜底通道，必须纳管
#     注意：该通道不带版本信息，客户端只在 VERSION 里配了 sha256 时才会使用它 ——
#     否则宁可报错也不会静默装上旧包。因此建议同时把 sha256 写进 VERSION
#     （python tools/make_release.py --write-sha256）。
# 发布包由 tools/make_release.py 生成，务必与 VERSION 同一次提交、同版本。
dist/*.exe
dist/*.spec
dist/*.pkg
dist/*.sha256
*.egg-info/
*.egg
.eggs/
lib/python*/

# Virtual Environment
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# ACRPA 运行时文件
logs/
screenshots/
# img/
*.log
config.json
# recent.json / recent_workflow.json 由 ACRPA.py 在运行时写入 (最近脚本 / 最近工作流节点)，
# 属于用户本机状态，不应入库
recent.json
recent_workflow.json

# ACRPA 构建资源（构建输入，必须纳入版本控制）
# res/ 内含 automation.ico / wechat_qrcode.png，被 ACRPA.spec 引用，请勿加入忽略规则

# Test coverage reports
htmlcov/
.coverage
coverage.xml
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# PyInstaller
# 生成的 spec 默认忽略；ACRPA.spec 目前作为例外纳管
# 注意：ACRPA.spec 由 build.py 生成（build.py:186-187 先删除、202-232 再重建），
#      每次构建都会被重写，因此纳管它会在 git status 中产生变更噪声。
*.spec
!ACRPA.spec

# PyInstaller 构建产物
dist/
build/

# UPX (如果使用)
upx.exe

# 脚本市场 v2 运行时产物 —— 均为本机下载 / 安装 / 仓库勘察产生，不入库
.tmp_recon/
market_scripts/
*.acrpapkg
# 根目录散落的脚本下载残留（脚本模板应放 template/，该目录已纳管）
/*.xls
